# /etc/archangel/archangel.toml
#
# Main configuration for the archangel daemon and executor.
# This file is read at startup; reload via `archangelctl reload`.
#
# Defaults are deliberately conservative. The daemon will refuse to start with
# settings that weaken security below the documented baseline.

[daemon]
# Operator trust store: Ed25519 public keys allowed to sign .exec bundles
# and policies. (Required.)
trust_store = "/etc/archangel/trust/operators.pubkeys"

# Append-only audit log. (Required.)
audit_log = "/var/log/archangel/audit.log.jsonl"

# Persistent audit signing key (hex seed). Generated 0600 on first start
# if absent. The daemon logs its public half at startup; pin that for
# `archangelctl audit-tail --key`.
audit_key = "/etc/archangel/trust/audit.key"

# Pinned operator public key for control-plane (boundary A) auth. Create
# it with `archangelctl init`.
operator_pubkey = "/etc/archangel/trust/operator.pub"

# Per-profile allowlist and signed .exec bundle directory.
allowlist  = "/etc/archangel/policies/allowlist.toml"
bundle_dir = "/etc/archangel/exec"

# Where archangeld publishes its per-run session PUBLIC key for the
# executor to read (rotated every restart). It is a public key; integrity
# comes from the directory's permissions, not secrecy.
session_pub = "/run/archangel/session.pub"

# Optional pinned TLS material for the LLM endpoint (forward-looking).
tls_pinning = "/etc/archangel/trust/ca.pem"

[sockets]
control = "/run/archangel/ctl.sock"
control_mode = 0o660            # must NOT grant 'other' (fail-closed)
control_group = "archangel"
exec = "/run/archangel/exec.sock"

# REQUIRED — there is no insecure default for either.
#   operator_uid : the UID of the human operator allowed to use the
#                  control socket (e.g. `id -u youruser`).
#   daemon_uid   : the UID archangeld runs as; the executor only accepts
#                  exec-socket connections from this UID
#                  (under systemd: `id -u archangel`).
# For a single-user manual test, set BOTH to your own `id -u`.
operator_uid = 1000
daemon_uid   = 1000

[session]
# Maximum concurrent sessions per operator.
max_concurrent = 4
# Per-session lifetime; sessions auto-expire and require re-auth.
ttl_seconds = 3600
# Per-task context isolation (#4). When true, each action starts a fresh
# conversation; the LLM does not see prior tasks in the same session.
per_task_isolation = true

[llm]
# Active backend: "anthropic" or "ollama". For offline first tests use
# "ollama" (no API key). For "anthropic" the token comes from the
# ARCHANGEL_LLM_TOKEN environment variable / systemd credential, NEVER
# from this file.
default_backend = "ollama"
# Model id. Omit to let the daemon pick a per-backend default.
# model = "claude-sonnet-4-6"
max_tokens = 1024

[llm.prompts]
# Spotlighting delimiters (#2) are randomized per session at runtime; this
# only sets the *minimum* entropy in bits.
spotlight_entropy_bits = 128
# Canary tokens (#3): how many distinct canaries to embed in the system prompt.
canary_count = 3

[modes]
# Default mode for new sessions when not explicitly set.
default = "interactive"
# Whether autonomous mode is allowed at all on this host. Off by default —
# operators must opt in explicitly per profile.
autonomous_allowed = false

[rate_limits]
# Layer #12. Per-session ceilings.
actions_per_minute = 20
mutating_actions_per_minute = 5
critical_actions_per_hour = 2
approval_requests_per_minute = 10

[approval]
# Layer #13. How operators receive approval requests in interactive mode.
# Supported: "tui", "ntfy", "webhook"
channels = ["tui"]
# Layer #14. Operations marked risk = "critical" require this many signatures.
critical_required_signatures = 2

[snapshots]
# Layer #16. Enable filesystem snapshots before mutating actions. Detected
# at startup; if no supported backend, snapshot-required actions are denied.
enabled = true
# Preference order: "btrfs", "zfs", "lvm-thin".
preferred_backend = "btrfs"

[egress]
# Layer #17. Kernel-level egress filtering for both the daemon and sandboxed
# actions. Defaults are restrictive.
default_policy = "deny"
allow = [
    # LLM endpoints — adjust to your active backend.
    # "api.anthropic.com",
    # "127.0.0.1:11434",   # Ollama
]
