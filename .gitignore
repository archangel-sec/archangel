# Operator key material — defense in depth even if developer mounts /etc/archangel locally
keys/
trust/
**/operators.pubkeys
**/operators.privkeys

# Build / packaging artifacts
/dist/
/build/
*.deb
*.rpm
*.tar.gz
*.tar.xz
*.tar.zst
*.sig
*.sbom.json

# Coverage / profiling
/coverage/
*.profraw
*.profdata
tarpaulin-report.html

# Fuzzing
/fuzz/corpus/
/fuzz/artifacts/

# Misc
*.log
*.tmp
