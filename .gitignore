# Rust
/target/
**/*.rs.bk
Cargo.lock.bak

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
.vs/

# Local config / secrets — must never be committed
*.local.toml
*.local.json
*.local.yml
*.local.yaml
.env
.env.*
!.env.example
secrets/
*.pem
*.key
*.pfx
*.p12
*.gpg
*.asc
