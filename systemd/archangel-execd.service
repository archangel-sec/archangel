[Unit]
Description=Archangel executor (privileged, isolated)
Documentation=https://github.com/archangel-sec/archangel
After=local-fs.target
Before=archangeld.service
DefaultDependencies=true

AssertPathExists=/sys/fs/cgroup/cgroup.controllers
AssertPathIsDirectory=/etc/archangel

[Service]
Type=notify
ExecStart=/usr/bin/archangel-execd --config /etc/archangel/archangel.toml
Restart=on-failure
RestartSec=2s
TimeoutStopSec=10s
WatchdogSec=30s

# --- Identity ---------------------------------------------------------------
User=archangel-exec
Group=archangel-exec
SupplementaryGroups=archangel-audit
DynamicUser=no

# --- Filesystem isolation ---------------------------------------------------
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/etc/archangel
ReadWritePaths=/var/lib/archangel-exec /var/log/archangel /run/archangel
PrivateTmp=true
# Executor needs to access device nodes for some actions; restricted via
# DeviceAllow= in drop-in if required.
PrivateDevices=true
PrivateUsers=false
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=false   # executor needs cgroup v2 to sandbox children
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid

# --- Network ----------------------------------------------------------------
# Executor itself does no network I/O. Sandboxed children get a fresh netns.
IPAddressDeny=any
RestrictAddressFamilies=AF_UNIX AF_NETLINK

# --- Privileges -------------------------------------------------------------
NoNewPrivileges=true
# Capabilities needed to construct sandboxes (clone with namespaces, mount,
# install seccomp). Minimal set; nothing related to network or kernel modules.
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_SYS_PTRACE CAP_DAC_READ_SEARCH CAP_SETUID CAP_SETGID CAP_CHOWN CAP_KILL
AmbientCapabilities=
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
SystemCallArchitectures=native
# Executor uses clone3, mount, unshare, seccomp; a stricter SystemCallFilter
# is computed per-action and installed in the child, not here.

# --- Resource limits --------------------------------------------------------
LimitNOFILE=8192
LimitNPROC=1024
TasksMax=512
# Delegate a cgroup v2 subtree (with cpu + memory controllers) so the executor
# can create a per-action child cgroup and write cpu.max/memory.max for bundles
# that declare resource ceilings (#11/#12). Without this, such a bundle is
# refused fail-closed rather than run unbounded.
Delegate=cpu memory pids

# --- Logging ----------------------------------------------------------------
StandardOutput=journal
StandardError=journal
SyslogIdentifier=archangel-execd

[Install]
WantedBy=multi-user.target
