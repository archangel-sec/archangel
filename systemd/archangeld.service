[Unit]
Description=Archangel daemon (LLM-facing, non-privileged)
Documentation=https://github.com/archangel-sec/archangel
# The executor binds the exec socket and reads the session key archangeld
# publishes; start it first, but only Wants (not Requires) so a failure is
# reported clearly rather than blocking the daemon from starting.
After=network-online.target archangel-execd.service
Wants=network-online.target archangel-execd.service

# Refuse to start in environments where systemd or kernel lacks the features
# we rely on. Operators can opt out via drop-in if they accept the risk.
AssertPathExists=/sys/fs/cgroup/cgroup.controllers
AssertPathIsDirectory=/etc/archangel

[Service]
# `exec`, not `notify`: the binary does not implement the sd_notify readiness
# protocol, so `notify` would leave systemd waiting for a READY=1 that never
# comes (start "times out" and the unit restart-loops despite working). With
# `exec`, the unit is active once the binary has successfully exec'd.
Type=exec
# The LLM token is never in the config file. `archangelctl setup` writes
# it (0600) to llm.env; the leading `-` makes it optional (absent for the
# offline Ollama backend, which needs no token).
EnvironmentFile=-/etc/archangel/llm.env
ExecStart=/usr/bin/archangeld --config /etc/archangel/archangel.toml
Restart=on-failure
RestartSec=2s
TimeoutStopSec=10s
# No WatchdogSec: it requires periodic sd_notify(WATCHDOG=1) pings the binary
# does not send yet (re-add when sd_notify support lands).

# --- Identity ---------------------------------------------------------------
User=archangel
Group=archangel
SupplementaryGroups=archangel-audit
DynamicUser=no

# --- Filesystem isolation ---------------------------------------------------
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/etc/archangel
ReadWritePaths=/var/lib/archangel /var/log/archangel /run/archangel
PrivateTmp=true
PrivateDevices=true
PrivateUsers=false
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid

# --- Network ----------------------------------------------------------------
# Daemon needs egress only to the configured LLM endpoint. Tighten via drop-in
# with IPAddressDeny=any + IPAddressAllow=<llm-endpoints> at install time.
IPAddressDeny=any
IPAddressAllow=localhost
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

# --- Privileges -------------------------------------------------------------
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
RestrictNamespaces=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @mount @swap @reboot @raw-io @cpu-emulation @debug @keyring @obsolete @clock @module

# --- Resource limits --------------------------------------------------------
LimitNOFILE=4096
LimitNPROC=512
TasksMax=256
MemoryHigh=512M
MemoryMax=1G

# --- Logging ----------------------------------------------------------------
StandardOutput=journal
StandardError=journal
SyslogIdentifier=archangeld

# --- Credentials -----------------------------------------------------------
# LLM tokens are passed via systemd credentials, never read from world-readable
# files. Configure via drop-in:
#   LoadCredentialEncrypted=anthropic-token:/etc/archangel/credentials/anthropic-token.enc
# The daemon reads them from $CREDENTIALS_DIRECTORY.

[Install]
WantedBy=multi-user.target
